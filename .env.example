# Prisma (Supabase Postgres). Prefer the transaction pooler on 6543.
# Session-mode pooler URLs (pooler host, port 5432) are rewritten to 6543 at runtime.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=no-verify
# DIRECT_URL is the session/direct port for migrations (5432).
# Encode # in the password as %23. Prisma also uses rejectUnauthorized: false for *.supabase.co.
DATABASE_URL=
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
NEXT_PUBLIC_SAAS_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing Supabase project (RPC fallback + cutover scripts)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Preview uses TEST keys + webhook to Next POST /api/webhooks/payments
# Production live webhook stays on TanStack /api/stripe/webhook until cutover phase E
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MAIL_FROM=
RESEND_API_KEY=

# Production cutover env (do not apply to the live Vercel project until phase E)
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify
# DIRECT_URL=<same or direct db host>
# BETTER_AUTH_SECRET=<new secret>
# RESEND_API_KEY=<live>
# NEXT_PUBLIC_SITE_URL=https://www.bid-ladder.lol
# NEXT_PUBLIC_SAAS_URL=https://www.bid-ladder.lol
